{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-dhcp.example.com/schemas/policy-conditions.json",
  "title": "Policy Conditions",
  "type": "object",
  "properties": {
    "deviceType": {
      "type": "string",
      "description": "Match requests from a specific device category"
    },
    "devicePersona": {
      "type": "string",
      "description": "Match normalized mobility persona such as byod or corporate"
    },
    "deviceTag": {
      "$ref": "#/$defs/stringSelector",
      "description": "Require at least one device tag (ios/android/etc)"
    },
    "deviceTags": {
      "$ref": "#/$defs/stringSelector",
      "description": "Alias supporting multi-tag filters"
    },
    "mdmManaged": {
      "type": "boolean",
      "description": "Match devices flagged as managed by an MDM connector"
    },
    "deviceMdmManaged": {
      "type": "boolean",
      "description": "Alias for mdmManaged when using dotted key notation"
    },
    "location": {
      "$ref": "#/$defs/stringSelector",
      "description": "Match logical location (Option82/relay metadata)"
    },
    "vlanID": {
      "type": "integer",
      "minimum": 0,
      "description": "Match access VLAN"
    },
    "ssid": {
      "type": "string",
      "description": "Match Wi-Fi SSID"
    },
    "userGroup": {
      "$ref": "#/$defs/stringSelector",
      "description": "Match logical user group tag (DHCP user-class/relay metadata)"
    },
    "userGroups": {
      "$ref": "#/$defs/stringSelector",
      "description": "Alias for userGroup supporting multi-value filters"
    },
    "timeRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Start time in HH:MM (24h)"
        },
        "end": {
          "type": "string",
          "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
          "description": "End time in HH:MM (24h)"
        },
        "days": {
          "$ref": "#/$defs/dayList"
        },
        "daysOfWeek": {
          "$ref": "#/$defs/dayList"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringSelector": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      ]
    },
    "dayList": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?i)(mon|monday|tue|tues|tuesday|wed|weds|wednesday|thu|thur|thurs|thursday|fri|friday|sat|saturday|sun|sunday|weekday|workday|weekend)$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
