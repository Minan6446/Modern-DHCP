{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modern-dhcp.example.com/schemas/policy-actions.json",
  "title": "Policy Actions",
  "type": "object",
  "properties": {
    "poolId": {
      "type": "string",
      "format": "uuid",
      "description": "Target address pool identifier"
    },
    "poolSelector": {
      "type": "object",
      "description": "Metadata selector used to resolve a matching pool at runtime",
      "properties": {
        "vlanId": {
          "type": "integer",
          "minimum": 1
        },
        "interfaceId": {
          "type": "string",
          "minLength": 1
        },
        "ssid": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "leaseProfile": {
      "type": "object",
      "properties": {
        "defaultDuration": {
          "type": "integer",
          "minimum": 60,
          "description": "Default lease duration seconds"
        },
        "minDuration": {
          "type": "integer",
          "minimum": 60
        },
        "maxDuration": {
          "type": "integer",
          "minimum": 60
        },
        "notificationLead": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "securityTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "anyOf": [
    { "required": ["poolId"] },
    { "required": ["poolSelector"] }
  ],
  "additionalProperties": false
}
