# Base env
#VITE_BASE=/
#VITE_APP_NAME=Modern DHCP
#VITE_API_BASE_URL=/api/v1
# 开发环境默认走 http://localhost:8080；只有后端明确启用了 API TLS 时才改成 https://localhost:8080 或对应地址
#VITE_API_PROXY_TARGET=http://localhost:8080
#VITE_API_PROXY_TARGET=https://localhost:8080
#VITE_WS_BASE=wss://ws.example.com
#VITE_TENANT_HEADER=X-Tenant-Id
#VITE_DEFAULT_TENANT=default

# i18n
#VITE_I18N_LOCALE=zh
#VITE_I18N_FALLBACK_LOCALE=en

# Behavior toggles
#VITE_THEME=light
#VITE_DROP_CONSOLE=false
##VITE_SOURCEMAP=false

VITE_BASE=/
VITE_API_BASE_URL=/api/v1
VITE_AUTH_PREFIX=/auth
VITE_TENANT_HEADER=X-Tenant-Id
VITE_DEFAULT_TENANT=global
VITE_I18N_LOCALE=zh
VITE_I18N_FALLBACK_LOCALE=en

